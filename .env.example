# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Claude API
# Either:
#   1) Direct from Anthropic: console.anthropic.com → key starts with `sk-ant-`
#   2) Internal proxy / Hermes / cc-switch: any key format the gateway accepts
ANTHROPIC_API_KEY=

# Custom gateway base URL (only set if NOT using Anthropic directly)
# Example for Deeplumen Hermes proxy: https://claude.deeplumen.cn
# Leave empty to hit Anthropic official.
ANTHROPIC_BASE_URL=

# Model overrides (defaults in src/lib/claude.ts)
# Hermes / proxies sometimes use vendor-specific names like "claude-opus-4.6"
# Set these if your gateway needs different model names.
# CLAUDE_MODEL_DEFAULT=claude-sonnet-4-5
# CLAUDE_MODEL_OPUS=claude-opus-4-1

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
